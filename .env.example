# Merchant app (local UI / production app subdomain)
VITE_APP_URL=http://localhost:5173
# Production: VITE_APP_URL=https://app.sakora.shop

VITE_API_URL=http://localhost:5100/api
# Production: VITE_API_URL=https://nexifour.ng/sakora/api

VITE_SITE_URL=https://sakora.shop

# Customer shops live on the website origin: https://sakora.shop/{slug}
# Locally the website itself is the storefront (port 5174).
VITE_STOREFRONT_URL=http://localhost:5174
# Production: omit or set VITE_STOREFRONT_URL=https://sakora.shop

# Optional socket host (defaults to API origin without /api)
# VITE_SOCKET_URL=http://localhost:5100

# Replace these with the live store listings and installer files when they are published.
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=shop.sakora.mobile
# VITE_APP_STORE_URL=https://apps.apple.com/app/id000000000
# VITE_DESKTOP_WINDOWS_URL=https://sakora.shop/downloads/Sakora-Setup.exe
# VITE_DESKTOP_MAC_URL=https://sakora.shop/downloads/Sakora.dmg
